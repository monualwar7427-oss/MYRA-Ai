    onPromptSelect: (String) -> Unit,
    onBack: () -> Unit,
    modifier: Modifier = Modifier
) {
    val prompts = listOf(
        ImagePromptIdea(
            title = "Lord Shiva / Mahadev",
            hindiTitle = "दिव्य महादेव",
            prompt = "महादेव भगवान शिव का ध्यानस्थ रूप, हिमालय की वादियों में, त्रिशूल और डमरू के साथ सुंदर विवरण",
